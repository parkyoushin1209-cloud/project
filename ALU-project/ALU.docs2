
package alu_pkg;
typedef uvm_sequencer #(sequence_item) sequencer;
typedef bit[2:0] {add_op  =  3'b000,
                  sub_op  =  3'b001,
                  mult_op =  3'b010,
                  and_op  =  3'b011,
                  or_op   =  3'b100,
                  xor_op  =  3'b101,
                  no_op   =  3'b110,
                  rst_op  =  3'b111} operation_t;

endpackage

interface alu_ifc(input logic clk);

import alu_pkg::*;
byte A, B;
operation_t op_set;
bit start, reset;
bit[2:0] op;
bit[15:0] result;
assign op = op_set;

command_monitor command_monitor_h;
result_monitor result_monitor_h;
endinterface

module top;
import alu_pkg::*;
import uvm_pkg::*;
`include "uvm_macros.svh"

logic clk, sclk;

initial begin
    forever #5 sclk = ~sclk; // DUT, TB용 클럭 발생기
end

clk_gen CG(clk); // driver, monitor용 클럭 발생기
alu_ifc ifc(clk);
ALU DUT(ifc, sclk);

initial begin
    uvm_config_db #(virtual alu_ifc) :: set(null, "*", "ifc", ifc);
    run_test();
end

endmodule

module clk_gen(output logic rclk);
logic clk = 0;
assign rclk = clk;

always #10 clk = ~clk;
endmodule

module ALU(input alu_ifc ifc, sclk);
always @(posedge sclk) begin
    if(ifc.reset) begin 
        ifc.result <= 0; 
        ifc.A <= 0; 
        ifc.B <= 0;
    end
    else begin
        case(ifc.op)
        add_op : ifc.result <= ifc.A + ifc.B;
        sub_op : ifc.result <= ifc.A - ifc.B;
        mult_op: ifc.result <= ifc.A * ifc.B;
        and_op : ifc.result <= ifc.A & ifc.B;
        or_op  : ifc.result <= ifc.A | ifc.B;
        xor_op : ifc.result <= ifc.A ^ ifc.B;
        no_op  : ifc.result <= ifc.result;
        //rst_op : ifc.reset  <= 1'b1; => 이건 드라이버 역할로
        endcase
    end
end
endmodule

virtual class alu_base_test extends uvm_test;
env env_h;
sequencer sequencer_h;

function new(string name, uvm_component parent);
super.new(name, parent);
endfunction

function void build_phase(uvm_phase phase);
env_h = env::type_id::create("env_h", this);
endfunction

function void end_of_elaboration_phase(uvm_phase phase);
sequencer_h = env_h.sequencer_h;
endfunction

endclass

class sequence_item extends uvm_sequence_item;
`uvm_object_utils(sequence_item)

function new(string name="");
super.new(name);
endfunction

rand byte A, B;
rand operation_t op;
bit[15:0] result;

constraint op_con { op dist {add_op := 5, sub_op := 5, mult_op := 5, and_op := 5,
                             or_op := 5, xor_op := 5, no_op := 1, rst_op := 1};}

constraint data {A dist {8'h00 := 1, [8'h01 : 8'hFE] :/ 50,8'hFF := 1};
                 B dist {8'h00 := 1, [8'h01 : 8'hFE] :/ 50, 8'hFF := 1};}

function string convert2string();
string s;
s = $sformatf("A:%2h,  B:%2h,   op:%s", A, B, op.name());
return s;
endfunction

function void do_copy(uvm_object rhs);
sequence_item RHS;
assert(rhs != null) else $fatal(1, "Tried to copy a null pointer");
super.do_copy(rhs);
assert($cast(RHS, rhs)) else $fatal(1, "Failed cast in do_copy")

A = RHS.A;
B = RHS.B;
op = RHS.op;
endfunction

function bit do_compare(uvm_object rhs, uvm_comparer comparer);
sequence_item RHS;
bit same;
assert(rhs != null) $fatal(1, "Tried to do compare to a null pointer");
same = super.do_compare(rhs, comparer) &&
       (A == RHS.A) &&
       (B == RHS.B) &&
       (op == RHS.op) &&
       (result == RHS.result);

return same;
endfunction

endclass


class env extends uvm_env;
`uvm_component_utils(env)

function new(string name, uvm_component parent);
super.new(name, parent);
endfunction

sequencer sequencer_h;
driver driver_h;
coverage coverage_h;
scoreboard scoreboard_h;
result_monitor result_monitor_h;
command_monitor command_monitor_h;

function void build_phase(uvm_phase phase);
sequencer_h = new("sequencer_h", this);
driver_h = driver::type_id::create("driver_h", this);
coverage_h = coverage::type_id::create("coverage_h", this);
scoreboard_h = scoreboard::type_id::create("scoreboard_h", this);
result_monitor_h = result_monitor::type_id::create("result_monitor_h", this);
command_monitor_h = command_monitor::type_id::create("command_monitor_h", this);
endfunction

function void connect_phase(uvm_phase phase);
driver_h.seq_item_port.connect(sequencer_h.seq_item_export);

command_monitor_h.ap.connect(coverage_h.analysis_export);
command_monitor_h.ap.connect(scoreboard_h.cmd_f.analysis_export);
result_monitor_h.ap.connect(scoreboard_h.analysis_export);
endfunction

endclass

class driver extends uvm_driver #(sequence_item);
`uvm_component_utils(driver)

virtual alu_ifc ifc;

function new(string name, uvm_component parent);
super.new(name, parent);
endfunction

function void build_phase(uvm_phase phase);
assert(uvm_config_db #(virtual alu_ifc) :: get(null, "*", "ifc", ifc)) else $fatal("Failed to get ifc");
endfunction 

task run_phase(uvm_phase phase);
sequence_item cmd;

forever begin
logic[2 * `dp_width-1:0] result;
seq_item_port.get_next_item(cmd);

case (cmd.op)
add_op : result = cmd.A + cmd.B;
sub_op : result = cmd.A - cmd.B;
mult_op : result = cmd.A * cmd.B;
and_op : result = cmd.A & cmd.B;
or_op : result = cmd.A | cmd.B;
xor_op : result = cmd.A ^ cmd.B;
rst_op : ifc.reset = 1;
endcase
cmd.result = result;
seq_item_port.item_done();
end
endtask

endclass


class command_monitor extends uvm_component;
`uvm_component_utils(command_monitor)

function new(string name, uvm_component parent);
super.new(name, parent);
endfunction

virtual alu_ifc ifc;
uvm_analysis_port #(sequence_item) ap;

function void build_phase(uvm_phase phase);
assert(uvm_config_db #(virtual alu_ifc) :: get(null, "*", "ifc", ifc))
else $fatal("Failed to get ifc");

ap = new("ap", this);
endfunction

function void connect_phase(uvm_phase phase);
bfm.command_monitor_h = this;
endfunction

function void write_to_monitor(input byte A, B, input operation_t op);
sequence_item cmd;
cmd = new("cmd");
cmd.A = A;
cmd.B = B;
cmd.op = op;
`uvm_info("COMMAND MONITOR", $sformatf("A:%4h B:%4h, op:%s ", cmd.A, cmd.B, cmd.op), UVM_MEDIUM);

ap.write(cmd);
endfunction

endclass





class result_transaction extends uvm_transaction;
`uvm_object_utils(result_transaction)

bit[15:0] result;

function new(string name = "");
super.new(name);
endfunction

function string convert2string();
string s;
s = $sformatf("result:%8h", result);
return s;
endfunction

function bit do_compare(uvm_object rhs, uvm_comparer comparer);
result_transaction RHS;
assert(rhs != null) else $fatal("Tried to compare null pointer");
same = super.do_compare(rhs, comparer);

$cast(RHS, rhs);
same = (result == RHS.result) && same;

return same;
endfunction

function void do_copy(uvm_object rhs);
result_transaction RHS;
assert(rhs != null) else $fatal("Tried to copy null pointer");
super.do_copy(rhs);
assert($cast(RHS, rhs)) else $fatal("Failed cast in do_copy");

result = RHS.result;
endfunction
endclass

class coverage extends uvm_subscriber #(sequence_item);
`uvm_component_utils(coverage)

byte A, B;
operation_t op;

covergroup cov_op;

  coverpoint op {
        

         bins opn_rst[] = ([add_op:xor_op] => rst_op);
         bins rst_opn[] = (rst_op => [add_op:xor_op]);

         bins twoops[] = ([add_op:xor_op] [* 2]);
         bins manymult = (mul_op [* 3:5]);

         bins rstmulrst   = (rst_op => mul_op [=  2] => rst_op);
         bins rstmulrstim = (rst_op => mul_op [-> 2] => rst_op);

      }

endgroup


covergroup zeros_or_ones_on_ops;

all_ops : coverpoint op_set {
         ignore_bins null_ops = {rst_op, no_op};}

      a_leg: coverpoint A {
         bins zeros = {'h00};
         bins others= {['h01:'hFE]};
         bins ones  = {'hFF};
      }

      b_leg: coverpoint B {
         bins zeros = {'h00};
         bins others= {['h01:'hFE]};
         bins ones  = {'hFF};
      }

      op_00_FF:  cross a_leg, b_leg, all_ops {
         bins add_00 = binsof (all_ops) intersect {add_op} &&
                       (binsof (a_leg.zeros) || binsof (b_leg.zeros));

         bins add_FF = binsof (all_ops) intersect {add_op} &&
                       (binsof (a_leg.ones) || binsof (b_leg.ones));
         
         bins sub_00 = binsof (all_ops) intersect {sub_op} &&
                       (binsof (a_leg.zeros) || binsof (b_leg.zeros));

         bins sub_FF = binsof (all_ops) intersect {sub_op} &&
                       (binsof (a_leg.ones) || binsof (b_leg.ones));


         bins and_00 = binsof (all_ops) intersect {and_op} &&
                       (binsof (a_leg.zeros) || binsof (b_leg.zeros));

         bins and_FF = binsof (all_ops) intersect {and_op} &&
                       (binsof (a_leg.ones) || binsof (b_leg.ones));

         bins xor_00 = binsof (all_ops) intersect {xor_op} &&
                       (binsof (a_leg.zeros) || binsof (b_leg.zeros));

         bins xor_FF = binsof (all_ops) intersect {xor_op} &&
                       (binsof (a_leg.ones) || binsof (b_leg.ones));

         bins mult_00 = binsof (all_ops) intersect {mult_op} &&
                       (binsof (a_leg.zeros) || binsof (b_leg.zeros));

         bins mult_FF = binsof (all_ops) intersect {mult_op} &&
                       (binsof (a_leg.ones) || binsof (b_leg.ones));

         bins mult_max = binsof (all_ops) intersect {mult_op} &&
                        (binsof (a_leg.ones) && binsof (b_leg.ones));

         bins or_00 = binsof (all_ops) intersect {or_op} &&
                       (binsof (a_leg.zeros) || binsof (b_leg.zeros));

         bins or_FF = binsof (or_ops) intersect {or_op} &&
                       (binsof (a_leg.ones) || binsof (b_leg.ones));

         ignore_bins others_only =
                                  binsof(a_leg.others) && binsof(b_leg.others);

      }

endgroup

function new(string name, uvm_component parent);
super.new(name, parent);
cov_op = new();
zeros_or_ones_on_ops = new();
endfunction

task write(sequence_item cmd);
A = cmd.A;
B = cmd.B;
op = cmd.op;
cov_op.sample();
zeros_or_ones_on_ops.sample();
endtask

endclass

class result_monitor extends uvm_component;
`uvm_component_utils(result_monitor)

virtual alu_ifc ifc;
uvm_analysis_port #(sequence_item) ap;

function new(string name, uvm_component parent);
super.new(name, parent);
endfunction

function void build_phase(uvm_phase phase);
assert(uvm_config_db #(virtual alu_ifc) :: get(null, "*", "ifc", ifc))
$fatal("Failed to get ifc");

ap = new("ap", this);
endfunction

function void connect_phase(uvm_phase phase);
bfm.result_monitor_h = this;
endfunction

function void write_to_monitor(bit[15:0] r);
result_transaction result_t;
result_t = new("result_t");
result_t.result = r;
ap.write(result_t);
endfunction

endclass

class scoreborad extends uvm_subscriber #(result_transaction);
`uvm_component_utils(scoreboard)

uvm_tlm_analysis_port #(sequence_item) cmd_f;

function new(string name, uvm_component parent);
super.new(name, parent);
endfunction

function void build_phase(uvm_phase phase);
cmd_f = new("cmd_f", this);
endfunction

function result_transaction predict_result(sequence_item cmd);
result_transaction predicted;
predicted = new("predicted");
case(cmd.op)
add_op : predicted.result = cmd.A + cmd.B;
sub_op : predicted.result = cmd.A - cmd.B;
mult_op : predicted.result = cmd.A * cmd.B;
and_op : predicted.result = cmd.A & cmd.B;
or_op : predicted.result = cmd.A | cmd.B;
xor_op : predicted.result = cmd.A ^ cmd.B;
default : `uvm_fatal("SCOREBOARD", "Not vaild");
endcase
return predicted;
endfunction

task write(result_transaction r);
sequence_item cmd;
result_transaction predicted;


do
assert(cmd_f.get_try(cmd)) else  $fatal(1, "Missing command in self checker");
while(cmd.op == no_op || cmd.op == rst_op);

predicted = predict_result(cmd);
if(!predicted.compare(r))
`uvm_error("SCOREBOARD", $sformatf("Mismatch: predicted %s != actual %s",
                                         predicted.convert2string(),
                                         r.convert2string()));
else
`uvm_info("SCOREBOARD", $sformatf("Match: predicted %s == actual %s", predicted.convert2string(), r.convert2string()), UVM_MEDIUM);


endtask

endclass

class random_test extends alu_base_test;
`uvm_component_utils(random_test)
random_sequence random; // sequence는 run_phase에서 생성함

function new(string name, uvm_component parent);
super.new(name, parent);
endfunction

task run_phase(uvm_phase phase);
random = new("random");
phase.raise_objection(this);
random.start(sequencer_h);
phase.drop_objection(this);
endtask
endclass

class random_sequence extends uvm_sequence #(sequence_item);
`uvm_object_utils(random_sequence)

function new(string name = "random_sequence");
super.new(name);
endfunction

sequence_item command;

task body();
command = sequence_item::type_id::create("command");
start_item(command);
assert(command.randomize());
finish_item(command);
`uvm_info("Random_sequence", $sformatf("command : %s", command.convert2string(), UVM_MEDIUM));
endtask

endclass



class sub_sequence_item extends sequence_item;
`uvm_object_utils(sub_sequence_item)

function new(string name);
super.new(name);
endfunction

constraint sub_only {op == sub_op;}

endclass

class sub_sequence extends uvm_sequence #(sequence_item);
`uvm_object_utils(sub_sequence)

sequence_item cmd;

function new(string name = "sub_sequence");
super.new(name);
endfunction

task body();
cmd = sub_sequence_item::type_id::create("sub_sequence_item");
start_item(cmd);
assert(cmd.randomize());
finish_item(cmd);
`uvm_info("sub_sequence", $sformatf("cmd : %s",cmd.randomize()), UVM_MEDIUM);
endtask
endclass

