class parallel_test extends alu_base_test;
`uvm_component_utils(parallel_test)

function new(string name, uvm_component parent);
super.new(name, parent);
endfunction

parallel_sequence parallel;

task run_phase(uvm_phase phase);
parallel = new("parallel");
phase.raise_objection(this);
parallel.start(sequencer_h);
phase.drop_objection(this);
endtask
endclass

class parallel_sequence extends uvm_sequence #(sequence_item);
`uvm_object_utils(parallel_sequence)
 // protect 시퀀스 여러개
protected mult_sequence mult;
protected sub_sequence sub;

function new(string name ="parallel");
super.new(name);
mult = mult_sequence::type_id::create("mult");
sub = sub_sequence::type_id::create("sub");
endfunction

task body();
fork
    mult.start(sequencer_h);
    sub.start(sequencer_h);
join
endtask
endclass
